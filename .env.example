# پیکربندی دیتابیس — همین مقادیر به‌عنوان پیش‌فرض داخل docker-compose.yml
# هم هست، بنابراین حتی بدون فایل .env سیستم بالا می‌آید.
# برای استقرار واقعی (production) مقادیر را تغییر دهید و این فایل را
# هرگز commit نکنید.
POSTGRES_USER=quant_user
POSTGRES_PASSWORD=quant_password
POSTGRES_DB=fund_db

# در بوت، اگر دیتابیس خالی باشد اسنپ‌شات داده واقعی (seed/dashboard_seed.sql.gz)
# بارگذاری می‌شود تا داشبورد از ثانیه اول کامل باشد؛ سینک زنده ادامه آن است.
# SEED_IF_EMPTY=0
